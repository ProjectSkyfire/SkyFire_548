# Native chat routing and presence. Durable social/guild state remains world-owned.
[chatserver]
# YYYYMMDDRR. Compare updated defaults before raising this serial in a live config.
ConfVersion = 2026092600
Chat.BindIP = "127.0.0.1"
Chat.Port = 54940
Chat.MaxConnections = 32
Chat.RequestTimeout = 5
# One daemon can serve multiple realms, e.g. "1 2 3". Zero and duplicates are invalid.
Chat.Realms = "1"
# Explicit certificate identity -> presence realm authorization. Blank disables publication.
Chat.WorldRealms = "skyfire-world-primary=1 skyfire-world-standby=1"
# Space-separated, exact world certificate common names. Empty fails startup.
Chat.AllowedWorlds = "skyfire-world-primary skyfire-world-standby"

Cluster.Enable = 1
Cluster.NodeKey = "skyfire-chat-primary"
Cluster.NodeName = "Chat Primary"
Cluster.HubHost = "localhost"
Cluster.HubPort = 9100
Cluster.AdvertiseAddress = "127.0.0.1"
# Paths relative to this configuration. Certificate needs clientAuth and serverAuth
# usages and a SAN matching the endpoint clients will verify.
Cluster.Certificate = "certs/chat-primary.crt"
Cluster.PrivateKey = "certs/chat-primary.key"
Cluster.CA = "certs/ca.crt"
Cluster.Handoff.Enable = 0
Cluster.RealmDirectory.Enable = 0

LogsDir = ""
Appender.Console = 1,2,0
Logger.root = 2,Console

# Signed revocation list populated by hub PKI/enrollment. Empty retains manual TLS.
Cluster.CRL = ""

# Native persistence/recovery foundation. This does not enable channel/guild cutover.
# Leave disabled until legacy writers and client adapters are migrated.
# Requires the social schema and this chat identity in allowed_chat_nodes at each
# realm's character service. Configure one numeric TLS endpoint for EVERY Chat.Realms entry.
Chat.Persistence.Enable = 0
Chat.Persistence.Realm.1.Host = "127.0.0.1"
Chat.Persistence.Realm.1.Port = 54930
Chat.Persistence.Realm.1.NodeKey = "characters-1"
