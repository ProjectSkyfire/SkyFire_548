# Paths are relative to this file. Python 3.11+ is required.
hub_config = "../hubserver.conf"
world_config = "../worldserver.conf"
# Absolute paths to MySQL 8+ client tools. On Linux, commonly /usr/bin/mysql and /usr/bin/mysqldump.
mysql = "C:/Program Files/MySQL/MySQL Server 9.7/bin/mysql.exe"
mysqldump = "C:/Program Files/MySQL/MySQL Server 9.7/bin/mysqldump.exe"
output_directory = "../backups"
timeout_seconds = 3600
minimum_free_mb = 1024
# 0 disables deletion. The newest verified point, pinned archives and rollback copies are protected.
retention_days = 30
# Full in-game .server shutdown warning before a scheduled backup set. Default: one hour.
shutdown_warning_seconds = 3600
# Resolve the OS time zone (Central on a server configured for Central), including DST.
# An explicit IANA name such as America/Chicago may also be used.
server_timezone = "system"
# Optional separate MySQL instance for restore verification (recommended, binary logging off).
# File format: VerificationDatabaseInfo = "127.0.0.1;3307;verification_admin;password;mysql"
# verification_config = "verification.conf"

# Enable only when this hub controls all writers to these databases.
# Other installations, scripts, and schema migrations must remain stopped during recovery.
allow_live_restore = false
