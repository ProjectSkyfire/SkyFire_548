###############################################
#    SkyFire Hub Server configuration file    #
###############################################
[hubserver]
ConfVersion=2026091806

###################################################################################################
# DATABASE SETTINGS
#
#    HubDatabaseInfo
#        Description: Connection settings for the hub database.
#        Example:     "hostname;port;username;password;database"
#        Default:     "127.0.0.1;3306;skyfire;skyfire;hub"

HubDatabaseInfo = "127.0.0.1;3306;skyfire;skyfire;hub"

# Startup setup/update checks run before database pools, listeners and managed services.
# Empty SqlPath disables the updater. Otherwise updates/hub must exist under this root.
# Use an absolute path, e.g. "D:/SkyFire/sql" or "/opt/skyfire/sql".
HubDatabase.SqlPath = ""

# Install base/hub_database.sql only into an empty schema (disabled by default).
# AutoCreate additionally allows creation of a missing database; requires CREATE privilege.
HubDatabase.AutoSetup = 0
HubDatabase.AutoCreate = 0

# One-time adoption of an existing, fully updated database without tracking.
# Records ALL discovered updates as applied without executing them. Apply outstanding
# migrations manually first; enable for one startup only, then disable it again.
HubDatabase.AutoBaseline = 0

# Reject changes to previously applied files by default. 1 warns and skips reapplication.
HubDatabase.AllowUpdateHashMismatch = 0

# Development/staging only: also scan pending_updates/hub. Leave disabled in production.
HubDatabase.ImportPendingUpdates = 0

#
#    HubDatabase.WorkerThreads
#        Description: Number of asynchronous hub database worker threads.
#        Default:     1

HubDatabase.WorkerThreads = 1

#
#    HubDatabase.SynchThreads
#        Description: Number of synchronous hub database connections.
#        Default:     1

HubDatabase.SynchThreads = 1

# Login database used by hub player-account administration (not the hub database).
# Leave empty to disable Accounts in the web console. Apply auth SQL updates first.
# Example: "127.0.0.1;3306;skyfire;skyfire;auth"
# The hub routes changes through its managed worldserver while online.
# Direct hub writes are allowed only while the managed world service is stopped.
LoginDatabaseInfo = ""

#
#    MaxPingTime
#        Description: Time in minutes between database keep-alive pings.
#        Important:   Must be between 1 and 1440.
#        Default:     30

MaxPingTime = 30

###################################################################################################
# HUB SERVER SETTINGS
#
#    Hub.BindIP
#        Description: Address the connection distribution hub will bind to.
#        Default:     "0.0.0.0" - (Bind to all available interfaces)

Hub.BindIP = "0.0.0.0"

#
#    Hub.Port
#        Description: TCP port for authenticated cluster registration when Hub.Cluster.Enable = 1.
#        Default:     9100

Hub.Port = 9100

# Cluster registration listener uses Hub.BindIP/Hub.Port only when enabled.
# This is a control-plane listener, not the public game/authentication entry point.
# Mutual TLS (minimum TLS 1.2) is mandatory. Paths are relative to the hub executable.
# Use a dedicated cluster CA; issue each node a client certificate whose single
# Common Name is its unique node key (ASCII letters, digits, '-', '_', '.', max 64).
# The server certificate must match the hostname used by clients.
# Registration is connection-owned and ephemeral. Send heartbeats more frequently
# than LeaseSeconds. Disconnected/expired nodes disappear; reconnect must register
# again and explicitly report ready. Changing these settings requires hub restart.
# In cluster mode, account changes require an available managed world. Direct
# offline hub account writes are disabled until remote dispatch is implemented.
# Local supervised processes continue using their existing control pipes alongside network agents.
# Never share the cluster CA with web clients.
Hub.Cluster.Enable = 0
Hub.Cluster.Certificate = ""
Hub.Cluster.PrivateKey = ""
Hub.Cluster.CA = ""
Hub.Cluster.LeaseSeconds = 15
Hub.Cluster.MaxConnections = 128

# Phase 5: the hub owns up to 65536 short-lived handoff records (maximum TTL 900 seconds).
# Auth/world nodes opt in with Cluster.Handoff.Enable. Deploy matching binaries together.
# Handoff requests require a current ready registration and mutual TLS; tokens/evidence are
# never sent to browsers or written to hub diagnostics. Use console 'handoffs' for counters.
# Consumed/revoked records remain until expiry to reject replay. Memory mode clears records
# on hub restart; database mode retains them using database UTC expiration.
# Existing world sessions are unaffected by handoff-store restart.
# World destinations bind the registration owner, so a restarted world cannot inherit an old grant.
# Store: memory (default) or database (requires pending hub durable-handoff migration).
# Database mode never falls back to memory on failure; affected logins must retry.
# This is shared handoff storage only, not multi-active hub/registry failover support.
Hub.Handoff.Store = "memory"

# Exactly one ready world node must own a requested realm. Multiple worlds
# for different realms are supported; overlapping realm ownership fails closed.
# Apply sql/updates/auth/2026_09_18_auth_00.sql before upgrading. Authnet session keys remain
# in the auth database; the account row also records whether its key requires hub handoff.


# Optional public authentication ingress. Each connection stays on one ready, leased auth node.
# Authnet and legacy protocols have separate listeners and are never mixed. Gameplay stays direct.
# Ports below avoid the existing backend ports (1119/3724). Point clients at the enabled ingress;
# Each authserver agent advertises one selected Cluster.AuthEndpoint; a legacy ingress needs
# a separately registered legacy endpoint, not the same node's unadvertised legacy listener.
# choose BindIP and firewall rules for your public entry point. Do not use a backend listener port
# on the same address as its ingress. Requires Hub.Cluster.Enable and registered auth agents.
#
# PreserveClientIP = 1 requires the backend's corresponding *.ProxyProtocol.Enable = 1 and
# TrustedPeers allowlist. The node advertises this capability; mismatched nodes are not selected.
# A trusted PROXY v1 header precedes the unchanged client stream on the backend connection only.
# PreserveClientIP = 0 selects only raw backends: their IP bans, audit and IP-based checks see the
# hub address, not the client. Use raw mode only for isolated compatibility tests.
# Backend authentication traffic is plaintext unless the client protocol encrypts it; keep backend
# links on a trusted private network. Registry mutual TLS does not encrypt forwarded traffic.
#
# Weights: space-separated node-key=weight pairs, 1..1000. Unlisted nodes have weight 1.
# Only authenticated live registry entries are eligible; hub_nodes rows do not activate routes.
# Capacity uses the greater of heartbeat load and locally reserved connections (including pending
# connects). Heartbeat load is sampled; this is not a global hard limit across multiple hubs.
# MaxConnections bounds each listener including connecting clients (1..65536).
# ConnectTimeout 1..30 seconds; IdleTimeout 5..86400 seconds; MaxAttempts 1..16 distinct nodes.
# Retry occurs only when TCP connect fails, before sending any header or client bytes.
# A connected backend failure closes that connection without replay. No session migration.
# Restart the hub for changes. Console 'routing' and web status expose route/failure counters.
#
# Maintenance (apply hub migrations 2026_09_18_hub_00.sql and 2026_09_18_hub_01.sql):
#   cluster drain <node-key>   Stop new auth connections/world handoffs; existing sessions finish.
#   cluster disable <node-key> Keep the node out of new routing until explicitly enabled again.
#   cluster enable <node-key>  Allow routing once the node also reports ready and has capacity.
# Equivalent buttons appear on auth and world cluster cards for operators with node-operation access.
# These commands do not kill services. Policy persists in hub_cluster_policy across reconnects and
# hub restarts; registration/heartbeats cannot change it. Saved offline nodes remain administrable.
# Registry and status show hub connections, including connecting clients. A zero count means this
# hub has drained its connections only; direct connections and other hubs are not counted. Backend
# connection failures back off per process for 1,2,4,...30 seconds; successful connects reset backoff.
# Expired/unready/maintenance nodes are excluded and pending connects withdrawn before forwarding.
# When no eligible node remains, new TCP connections close; 'routing' and web status report why.
# Existing connections never migrate or replay data. A lost backend ends its sessions: clients must
# reconnect/login again. Worldserver disappearance removes its live registration; recovery must
# register and report ready anew. Gameplay remains direct. World drain/disable withdraws new realm
# routes and handoffs; it does not stop existing gameplay. Use graceful world commands to stop.
# Console 'realms' combines configured realm identity/access with live endpoint availability.
# Authserver Cluster.RealmDirectory.Enable uses authenticated message 7 queries (capability 128).
# A realm with multiple live world owners is unavailable; this does not replicate gameplay state.
# Changes made to policy by
# this hub are immediate; another hub sharing the DB must reload policy by restarting before use.

Hub.AuthnetIngress.Enable = 0
Hub.AuthnetIngress.BindIP = "127.0.0.1"
Hub.AuthnetIngress.Port = 1118
Hub.AuthnetIngress.PreserveClientIP = 1
Hub.AuthnetIngress.Weights = ""
Hub.AuthnetIngress.MaxConnections = 4096
Hub.AuthnetIngress.ConnectTimeout = 3
Hub.AuthnetIngress.IdleTimeout = 300
Hub.AuthnetIngress.MaxAttempts = 3

Hub.LegacyIngress.Enable = 0
Hub.LegacyIngress.BindIP = "127.0.0.1"
Hub.LegacyIngress.Port = 3723
Hub.LegacyIngress.PreserveClientIP = 1
Hub.LegacyIngress.Weights = ""
Hub.LegacyIngress.MaxConnections = 4096
Hub.LegacyIngress.ConnectTimeout = 3
Hub.LegacyIngress.IdleTimeout = 300
Hub.LegacyIngress.MaxAttempts = 3

# Authentication ingress packet capture uses the auth/world per-session text format.
# Enable continuously with Hub.PacketLog.Enable, or set PacketLogServerControlFile to
# "packetlogserver.active" to follow the existing packetlogserver on-demand switch.
# Files use hubauthnet/hubauth prefixes; headers identify the client and markers the node/backend.
# HUB_TCP_READ entries contain bytes received in each direction, before forwarding. TCP chunks
# are not decoded protocol packets: opcode 0 is a placeholder, and chunks may split/combine packets.
# Generated PROXY headers are excluded. Gameplay stays direct and is logged by worldserver.
# Account/character filters are unavailable because the hub does not decode authentication.
# Capture includes raw authentication data; use it only while diagnosing traffic.
# Output directory is relative to the hub working directory. Config changes require restart;
# control-file presence is checked during traffic. No capture occurs while ingress is disabled.
Hub.PacketLog.Enable = 0
PacketLogServerControlFile = ""
PacketLogServerOutputDir = "PacketLogs"

#
#    Console.Enable
#        Description: Enable the interactive hub command console.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Console.Enable = 1

###################################################################################################
# WEB CONSOLE SETTINGS
#
#    Web.Enable
#        Description: Enable the self-contained hub web console.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Web.Enable = 1

#
#    Web.BindIP
#        Description: Address the web console will bind to.
#        Important:   Keep this on loopback unless remote access is intentionally configured.
#        Default:     "127.0.0.1"

Web.BindIP = "127.0.0.1"

#
#    Web.Port
#        Description: HTTP port for the web console.
#        Important:   TCP ports must be between 1 and 65535.
#        Default:     54880

Web.Port = 54880

#
#    Web.Root
#        Description: Directory containing the hub web interface files.
#                     Relative paths are resolved from the hubserver executable directory.
#        Default:     "web"

Web.Root = "web"

#
#    Web.AllowRemote
#        Description: Permit non-loopback clients to reach the web console.
#        Important:   Remote administrators must also have the remote-login access flag.
#        Default:     0 - (Disabled)

Web.AllowRemote = 0

# Phase 7 Python HTTPS/WebSocket gateway. Leave empty to disable the private gateway API.
# Apply sql/updates/hub/2026_09_18_hub_02.sql first. Generate 32 random bytes as 64 lowercase
# hex characters in this file; share it only with the control service. Relative to this config.
# Requires Web.BindIP to be loopback and Web.AllowRemote=0. Public TLS terminates in control/.
# Gateway logins also require access flag 16. Local console: admin role <name> <role> remote.
# Roles: viewer, operator, administrator, recovery (reserved; backups arrive in Phase 8).
# Remote requests accept only typed lifecycle/maintenance commands, never console text or paths.
Web.ControlTokenFile = ""

#
#    Web.SessionTimeout
#        Description: Absolute authenticated web session lifetime in seconds; polling does not extend it.
#        Default:     1800 - (30 minutes)

Web.SessionTimeout = 1800

###################################################################################################
# LOGGING SYSTEM SETTINGS
#
#    LogsDir
#        Description: Directory for log files. The directory must already exist.
#        Default:     "" - (Use the current directory)

LogsDir = ""

#
#    Log.Async.Enable
#        Description: Enable asynchronous log writing.
#        Default:     0 - (Disabled)

Log.Async.Enable = 0

Appender.Console=1,2,0, 13 11 9 5 3 1
Logger.root=3,Console
# Bounded handoff audit files contain identities/results, never tokens or key fingerprints.
Appender.Handoff=2,3,0,Handoff.log,a,10485760
Logger.server.handoff=3,Handoff

# Certificate common names allowed to discover map data providers during world startup.
# Space-separated node keys; empty disables map discovery. Mapserver also has its own allowlist.
Hub.MapData.Readers = ""

# Player warning before Restart all stops worlds gracefully (0..3600 seconds).
Hub.Restart.Countdown = 60

# Same-host cold standby: one configured pair, no cross-machine fencing or session migration.
# Both managed worlds must use the SAME executable, databases, realm and absolute local
# World.OwnershipLock file; use different node keys/certificates and config files.
# Configure only after upgrading both binaries/configs and stopping any unfenced writers.
# Settings are read at hub startup. Promotion uses durable node-restart maintenance ownership.
# Automatic promotion is one-way (primary -> standby), only after an OS-confirmed unexpected
# exit of a previously ready, fenced primary. Never triggered by heartbeat loss/startup failure.
# No automatic retries or failback. Planned stop/restart/backup cycles do not promote standby.
Hub.Fallback.Enable = 0
Hub.Fallback.Primary = "world"
Hub.Fallback.Standby = "world-standby"
Hub.Fallback.Automatic = 0
Hub.Fallback.Countdown = 60
# Optional preventive switchover: fresh world update time at/above this threshold for
# DegradedSeconds requests a normal graceful shutdown/save while the primary responds.
# Requires Automatic=1. 0 disables; tune from measured tick latency, not CPU alone.
# This cannot predict abrupt crashes or solve a shared database bottleneck.
Hub.Fallback.DegradedUpdateMs = 0
Hub.Fallback.DegradedSeconds = 60
