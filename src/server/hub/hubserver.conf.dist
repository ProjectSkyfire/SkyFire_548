###############################################
#    SkyFire Hub Server configuration file    #
###############################################
[hubserver]
ConfVersion=2026091601

###################################################################################################
# DATABASE SETTINGS
#
#    HubDatabaseInfo
#        Description: Connection settings for the hub database.
#        Example:     "hostname;port;username;password;database"
#        Default:     "127.0.0.1;3306;skyfire;skyfire;hub"

HubDatabaseInfo = "127.0.0.1;3306;skyfire;skyfire;hub"

#
#    HubDatabase.WorkerThreads
#        Description: Number of asynchronous hub database worker threads.
#        Default:     1

HubDatabase.WorkerThreads = 1

#
#    HubDatabase.SynchThreads
#        Description: Number of synchronous hub database connections.
#        Default:     1

HubDatabase.SynchThreads = 1

# Login database used by hub player-account administration (not the hub database).
# Leave empty to disable Accounts in the web console. Apply auth SQL updates first.
# Example: "127.0.0.1;3306;skyfire;skyfire;auth"
# The hub routes changes through its managed worldserver while online.
# Direct hub writes are allowed only while the managed world service is stopped.
LoginDatabaseInfo = ""

#
#    MaxPingTime
#        Description: Time in minutes between database keep-alive pings.
#        Important:   Must be between 1 and 1440.
#        Default:     30

MaxPingTime = 30

###################################################################################################
# HUB SERVER SETTINGS
#
#    Hub.BindIP
#        Description: Address the connection distribution hub will bind to.
#        Default:     "0.0.0.0" - (Bind to all available interfaces)

Hub.BindIP = "0.0.0.0"

#
#    Hub.Port
#        Description: TCP port reserved for the connection distribution hub.
#        Default:     9100

Hub.Port = 9100

#
#    Console.Enable
#        Description: Enable the interactive hub command console.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Console.Enable = 1

###################################################################################################
# WEB CONSOLE SETTINGS
#
#    Web.Enable
#        Description: Enable the self-contained hub web console.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)

Web.Enable = 1

#
#    Web.BindIP
#        Description: Address the web console will bind to.
#        Important:   Keep this on loopback unless remote access is intentionally configured.
#        Default:     "127.0.0.1"

Web.BindIP = "127.0.0.1"

#
#    Web.Port
#        Description: HTTP port for the web console.
#        Important:   TCP ports must be between 1 and 65535.
#        Default:     54880

Web.Port = 54880

#
#    Web.Root
#        Description: Directory containing the hub web interface files.
#                     Relative paths are resolved from the hubserver executable directory.
#        Default:     "web"

Web.Root = "web"

#
#    Web.AllowRemote
#        Description: Permit non-loopback clients to reach the web console.
#        Important:   Remote administrators must also have the remote-login access flag.
#        Default:     0 - (Disabled)

Web.AllowRemote = 0

#
#    Web.SessionTimeout
#        Description: Authenticated web session lifetime in seconds, refreshed by activity.
#        Default:     1800 - (30 minutes)

Web.SessionTimeout = 1800

###################################################################################################
# LOGGING SYSTEM SETTINGS
#
#    LogsDir
#        Description: Directory for log files. The directory must already exist.
#        Default:     "" - (Use the current directory)

LogsDir = ""

#
#    Log.Async.Enable
#        Description: Enable asynchronous log writing.
#        Default:     0 - (Disabled)

Log.Async.Enable = 0

Appender.Console=1,2,0, 13 11 9 5 3 1
Logger.root=3,Console
